# Example OpenAI-compatible environment variables
# Copy this file to `.env` and fill in your keys.

# Your OpenAI API key
OPENAI_API_KEY=your-openai-api-key-here

# Model to use for agent/chat/tooling (example: gpt-4o, gpt-4-turbo)
OPENAI_MODEL=gpt-4o

# Optional: custom base URL for OpenAI-compatible providers (leave commented to use OpenAI)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: if using a third-party provider (CLOD/Moonshot/etc), set the provider base URL
# CLOD example:
# OPENAI_BASE_URL=https://api.clod.io/v1
# OPENAI_MODEL=kimi-k2.6
